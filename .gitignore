# Historic local-only research snapshots (not production source)
/validation_20101212/
/one_month_pipeline/
/one_month_preprocessing_detection_survey/

# Calibration assets: binary local FITS are installed independently.
# Code verifies the required cor2A mask by SHA-256.
# Do not ignore Calibration/*.py or other calibration documentation.
/Calibration/*.fts
/Calibration/*.fits
/Calibration/*.fit

